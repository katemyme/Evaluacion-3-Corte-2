<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.casos_de_estudio.MenuController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Casos de estudio" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Button text="Caja de ventas" prefWidth="200.0" onAction="#onCajaButtonClick"/>
    <Button text="Procesamiento de pedidos" prefWidth="200.0" onAction="#onRegistroButtonClick"/>
    <Button text="Reserva concurrente" prefWidth="200.0" onAction="#onReservaButtonClick"/>
</VBox>
