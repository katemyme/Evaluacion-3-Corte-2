<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ni.edu.uam</groupId>
        <artifactId>Casos_de_estudio</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>Menu_principal</artifactId>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
        </dependency>

        <!-- Los tres casos de estudio que abre el menu -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>Caja_de_ventas</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>Procesamiento_de_pedidos</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>Reserva_Concurrente</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <mainClass>ni.edu.uam.casos_de_estudio/ni.edu.uam.casos_de_estudio.MainApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
